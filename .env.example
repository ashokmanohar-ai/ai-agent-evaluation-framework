# Offline-safe default used by CI and local smoke runs.
EVAL_MODEL_PROVIDER=mock
EVAL_AGENT=mock
EVAL_CONFIG=config/evaluation.yaml
EVAL_QUALITY_GATES=config/quality-gates.yaml

# Optional provider settings. Supply only for intentional live-model evaluation.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Optional OTLP/Phoenix tracing.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
